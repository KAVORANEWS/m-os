#!/bin/sh
# Brand and harden the Calamares installer configuration for M OS.
set -e
CFG=/etc/calamares
[ -d "$CFG" ] || { echo "calamares not installed" >&2; exit 1; }
[ -f "$CFG/branding/mos/branding.desc" ] || { echo "M OS installer branding missing" >&2; exit 1; }

# Use M OS branding
sed -i 's/^branding:.*/branding: mos/' "$CFG/settings.conf"

# Require 8+ character passwords for the created account
sed -i 's/^\(\s*\)minLength:.*/\1minLength: 8/' "$CFG/modules/users.conf"
sed -i 's/^\(\s*\)- minlen=0/\1- minlen=8/' "$CFG/modules/users.conf"

# M OS needs less disk than the Debian default estimate
sed -i 's/requiredStorage:.*/requiredStorage:    20/' "$CFG/modules/welcome.conf"

# Launcher identity
for f in /usr/share/applications/calamares-install-debian.desktop; do
    [ -f "$f" ] || continue
    sed -i -e 's/^Name=.*/Name=Install M OS/' -e '/^Name\[/d' \
           -e 's/^GenericName=.*/GenericName=Install M OS to this computer/' -e '/^GenericName\[/d' \
           -e 's/^Comment=.*/Comment=Install M OS to this computer/' -e '/^Comment\[/d' \
           -e 's/^Icon=.*/Icon=mos-logo/' "$f"
done

# After installation the live-only welcome shortcut and installer are removed
# by Calamares' packages module (calamares-settings-debian behaviour).
grep -n "branding:" "$CFG/settings.conf"
