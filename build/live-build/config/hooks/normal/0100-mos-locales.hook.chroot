#!/bin/sh
# Generate the English and Sinhala locales shipped by M OS.
set -e
for loc in "en_US.UTF-8 UTF-8" "en_GB.UTF-8 UTF-8" "si_LK UTF-8"; do
    if grep -q "^# *${loc}\$" /etc/locale.gen; then
        sed -i "s/^# *${loc}\$/${loc}/" /etc/locale.gen
    elif ! grep -q "^${loc}\$" /etc/locale.gen; then
        echo "${loc}" >> /etc/locale.gen
    fi
done
locale-gen
update-locale LANG=en_US.UTF-8
