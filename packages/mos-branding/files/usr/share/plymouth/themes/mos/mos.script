# M OS Plymouth theme. License: CC-BY-SA-4.0
Window.SetBackgroundTopColor(0.067, 0.078, 0.227);
Window.SetBackgroundBottomColor(0.027, 0.039, 0.094);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30;
logo.sprite.SetPosition(logo.x, logo.y, 10);

# Three pulsing dots under the logo
for (i = 0; i < 3; i++) {
    dot[i].image = Image("dot.png");
    dot[i].sprite = Sprite(dot[i].image);
    dot[i].sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - 22 + i * 18,
                              logo.y + logo.image.GetHeight() + 40, 10);
}

frame = 0;
fun refresh_callback() {
    frame++;
    for (i = 0; i < 3; i++) {
        dot[i].sprite.SetOpacity(0.35 + 0.65 * Math.Abs(Math.Sin(frame / 18 - i * 0.6)));
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---- Password prompt (e.g. encrypted disks) ------------------------------
status = "normal";
fun display_normal_callback() {
    status = "normal";
    if (global.prompt_sprite) prompt_sprite.SetOpacity(0);
    if (global.bullet_sprite) bullet_sprite.SetOpacity(0);
}
fun display_password_callback(prompt, bullets) {
    status = "password";
    prompt_image = Image.Text(prompt, 0.9, 0.9, 1.0);
    prompt_sprite = Sprite(prompt_image);
    prompt_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - prompt_image.GetWidth() / 2,
                              logo.y + logo.image.GetHeight() + 80, 20);
    text = "";
    for (j = 0; j < bullets; j++) text += "•";
    if (bullets == 0) text = " ";
    bullet_image = Image.Text(text, 1, 1, 1);
    bullet_sprite = Sprite(bullet_image);
    bullet_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - bullet_image.GetWidth() / 2,
                              logo.y + logo.image.GetHeight() + 110, 20);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun message_callback(text) {
    msg_image = Image.Text(text, 0.7, 0.7, 0.85);
    msg_sprite = Sprite(msg_image);
    msg_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - msg_image.GetWidth() / 2,
                           Window.GetY() + Window.GetHeight() - 60, 20);
}
Plymouth.SetMessageFunction(message_callback);
