#!/bin/sh
set -e

# Select the M OS boot splash, but only once plymouth itself is fully
# configured. Running plymouth-set-default-theme while plymouth is merely
# unpacked creates /etc/plymouth/plymouthd.conf before dpkg installs the
# conffile, which causes an interactive conffile prompt.
set_plymouth_theme() {
    if [ "$(dpkg-query -W -f='${db:Status-Abbrev}' plymouth 2>/dev/null)" = "ii " ] &&
       command -v plymouth-set-default-theme >/dev/null 2>&1; then
        if [ "$(plymouth-set-default-theme 2>/dev/null)" != mos ]; then
            plymouth-set-default-theme mos || true
            dpkg-trigger --no-await update-initramfs 2>/dev/null || true
        fi
    fi
}

case "$1" in
    configure)
        set_plymouth_theme
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
        fi
        ;;
    triggered)
        # plymouth was installed or upgraded after mos-branding
        set_plymouth_theme
        ;;
esac
#DEBHELPER#
exit 0
